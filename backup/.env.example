# Where the server is, as an SSH target. The key mounted below must be able to
# reach it without a passphrase.
RHDB_HOST=root@db.2600.me

# Where the backup is kept. Two directories are created under it: repo/ holds the
# restic repository (the backup itself) and stage/ a mirror of the server. Give it
# real disk: the first snapshot is about the size of the photo volume (260 MB
# today) and later ones cost only what changed, so a year is well under a gigabyte.
#
# A NAS path is fine here -- an NFS or SMB mount, or a Synology shared folder.
BACKUP_DIR=/mnt/nas/backup/rhdb

# Optional: keep the working mirror on local disk while the repository lives on
# the NAS. Faster, and it halves what the NAS holds. Losing it costs one slow
# night re-transferring photos, never any history.
#STAGE_DIR=/var/lib/rhdb-backup-stage

# Optional: skip the mount entirely and let restic speak to the NAS directly.
# Needs the SSH key below to reach it, or the matching credentials for s3.
#RESTIC_REPOSITORY=sftp:admin@nas:/volume1/backup/rhdb

# The key that reaches the server, and the password encrypting the repository.
# Generate them once, into the secrets/ directory that ships empty with the repo:
#   ssh-keygen -t ed25519 -N "" -f ./secrets/id_ed25519
#   openssl rand -base64 32 > ./secrets/restic-password
#   chmod 600 ./secrets/restic-password
# Then add the public key to the server: ssh-copy-id -i ./secrets/id_ed25519 root@db.2600.me
SSH_KEY=./secrets/id_ed25519
RESTIC_PASSWORD_FILE=./secrets/restic-password

# Local time of the nightly run.
BACKUP_AT=03:30

# Report every file rsync moved and every blob restic stored. Useful for a first
# run or when something looks wrong; several hundred lines a night otherwise.
#VERBOSE=1
TZ=Europe/London

# Keep the server's .env (database passwords, cookie secret) in the backup. The
# repository is encrypted, and without it a restore cannot reproduce credentials.
INCLUDE_ENV=1

# Retention. Roughly: a week of nights, five weeks of Sundays, a year of months,
# three years of years.
KEEP_DAILY=7
KEEP_WEEKLY=5
KEEP_MONTHLY=12
KEEP_YEARLY=3

# Paths ON THE SERVER, not on this machine -- the repo directory is read over SSH
# to source its .env and run the dump. The defaults are correct for db.2600.me;
# change them only if the server's layout differs. Where you cloned this backup
# directory locally has nothing to do with either.
RHDB_DIR=/root/retro-hardware-db-2
RHDB_IMAGES=/var/lib/docker/volumes/retro-hardware-db-2_images/_data
