# Where the server is, as an SSH target. The key mounted below must be able to
# reach it without a passphrase.
RHDB_HOST=root@db.2600.me

# Where this machine keeps the backup. Give it real disk: the first snapshot is
# about the size of the photo volume (260 MB today), and later ones cost only
# what changed.
BACKUP_DIR=/srv/backup/rhdb

# The key that reaches the server, and the password encrypting the repository.
# Generate them once:
#   ssh-keygen -t ed25519 -N "" -f ./secrets/id_ed25519
#   openssl rand -base64 32 > ./secrets/restic-password
# Then add the public key to the server: ssh-copy-id -i ./secrets/id_ed25519 root@db.2600.me
SSH_KEY=./secrets/id_ed25519
RESTIC_PASSWORD_FILE=./secrets/restic-password

# Local time of the nightly run.
BACKUP_AT=03:30
TZ=Europe/London

# Keep the server's .env (database passwords, cookie secret) in the backup. The
# repository is encrypted, and without it a restore cannot reproduce credentials.
INCLUDE_ENV=1

# Retention. Roughly: a week of nights, five weeks of Sundays, a year of months,
# three years of years.
KEEP_DAILY=7
KEEP_WEEKLY=5
KEEP_MONTHLY=12
KEEP_YEARLY=3

# Only change these if the server's layout differs.
RHDB_DIR=/root/retro-hardware-db-2
RHDB_IMAGES=/var/lib/docker/volumes/retro-hardware-db-2_images/_data
