.env
__pycache__/
*.pyc
*.db
.venv/
.venv-test/
.pytest_cache/

*-journal
*.sqlite

# Generated by the ported tools
tools/site/
tools/labels/*.pdf
tools/labels/*.html

# Boot-disk detector reports are machine-specific inputs
tools/imports/*.txt
tools/imports/*.TXT

# Local backups
backups/

# Worktrees an agent session makes for itself, under a directory the repo does
# otherwise track: .claude/rules/ is the standards and belongs here, a checkout
# of the whole tree beside it does not.
.claude/worktrees/

# Hand-off notes shared with the maintainer directly, kept out of the repo
/FINDINGS.md
/HARDENING-NOTES.md
/docs/superpowers/

# Local Caddy blocks (other names, redirects) belong to the deployment, not the repo
caddy/conf.d/*.caddy
!caddy/conf.d/empty.caddy

# This installation's own logo, icons and share card
branding/*
!branding/README.md
