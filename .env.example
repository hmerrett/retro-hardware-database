DB_NAME=retro
DB_USER=retro
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Auth for the API + GUI. Leave both blank to run open (local dev).
# Set them to require credentials; the MCP server and tools send the same ones.
# The browser logs in with these (cookie session); the API/tools use HTTP Basic.
RHDB_AUTH_USER=
RHDB_AUTH_PASSWORD=

# Say that running with no login is deliberate. Leave unset unless it is.
#
# Blank credentials make every visitor the owner -- able to edit and delete
# anything -- and a .env that is missing or was left behind when the checkout moved
# produces exactly that, with nothing to show for it but two controls quietly gone
# from a menu. So the app assumes the mistake: with no credentials and no RHDB_OPEN
# it warns at startup and puts a banner on every page. Set this to 1 on an
# installation that is open on purpose and both go quiet (ADR-0019).
RHDB_OPEN=

# Secret that signs the browser login cookie. Generate: openssl rand -hex 32
# Required when the auth above is set -- the app refuses to start without it.
# (It used to fall back to a hash of the credentials; that made a leaked cookie
# an offline oracle for the password.) Leave blank only when running open.
RHDB_SECRET_KEY=

# The name this installation answers to. Caddy serves this name and gets a
# certificate for it, so it must be a real name whose A record points at this host.
RHDB_DOMAIN=db.example.com

# Where Let's Encrypt writes about certificates (expiry, problems).
RHDB_ACME_EMAIL=you@example.com

# The public base URL of the app -- what the QR codes on printed labels encode, and
# what links in shared cards point at. Defaults to https://$RHDB_DOMAIN; set it
# only if those differ (behind another proxy, or on a non-standard port).
RHDB_BASE_URL=https://db.example.com

# Watermark our own photos with the site icon as they are served. Reference
# images (someone else's photo of the same model) and icons are never marked.
# Set to 0 to serve every photo untouched. The mark is your own logo if you have
# put one in branding/ (see branding/README.md), and the shipped placeholder if not.
RHDB_WATERMARK=1
