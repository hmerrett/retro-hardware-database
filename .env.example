DB_NAME=retro
DB_USER=retro
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Accounts live in the database (ADR-0032). A new installation opens on /setup,
# which asks for a setup code the app writes to its log:
#   docker compose logs api | grep -i "setup code"
# Accounts and API tokens are managed with:
#   docker compose exec api python -m app.accounts --help

# The old single login. Leave blank on a new installation. On one upgraded from
# it, the first start makes an administrator from this pair; after that the site
# does not read it, and the tool server uses it only until RHDB_API_TOKEN is set.
RHDB_AUTH_USER=
RHDB_AUTH_PASSWORD=

# The tool server's key to the API: make one with
#   docker compose exec api python -m app.accounts token <username> "tool server"
RHDB_API_TOKEN=

# The name this installation answers to. Caddy serves this name and gets a
# certificate for it, so it must be a real name whose A record points at this host.
RHDB_DOMAIN=db.example.com

# Where Let's Encrypt writes about certificates (expiry, problems).
RHDB_ACME_EMAIL=you@example.com

# The public base URL of the app -- what the QR codes on printed labels encode, and
# what links in shared cards point at. Defaults to https://$RHDB_DOMAIN; set it
# only if those differ (behind another proxy, or on a non-standard port).
RHDB_BASE_URL=https://db.example.com

# Watermark our own photos with the site icon as they are served. Reference
# images (someone else's photo of the same model) and icons are never marked.
# Set to 0 to serve every photo untouched. The mark is your own logo if you have
# put one in branding/ (see branding/README.md), and the shipped placeholder if not.
#
# This is also a setting on the site itself, at ... -> Settings. Set here it wins,
# and the page shows the value greyed with this variable named beside it; comment
# it out to hand the choice back to the page.
RHDB_WATERMARK=1

# The label printers that are not attached to this machine, and the key each one's
# agent holds. `name:key:stock:format`, separated by commas; the stock and the
# format may be left off and default to a 51x19mm DYMO tape printed as a PDF.
#
#   RHDB_PRINT_AGENTS=workshop-pi:9f3c...:dymo-11355:pdf,bench:1a7d...:niimbot-50x30:png
#
# Generate a key each with `openssl rand -hex 32` and never reuse one. A key opens
# that agent's own queue and nothing else -- it cannot read the register and it is
# not the password. With nothing set here there is no print queue at all, which is
# what an installation that prints from the browser wants.
RHDB_PRINT_AGENTS=
