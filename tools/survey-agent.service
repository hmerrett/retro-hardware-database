[Unit]
# The survey agent, for the server the machines' network drive lives on.
#
#   sudo cp survey-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now survey-agent
#   journalctl -u survey-agent -f
#
# Edit the four Environment lines and ReadWritePaths below, and nothing else. The
# key is this agent's own, out of RHDB_SURVEY_AGENTS in the register's .env; it is
# not the password.
Description=Retro Hardware Database survey agent
Documentation=https://github.com/hmerrett/retro-hardware-database
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Environment=RHDB_API=https://db.example.com
Environment=RHDB_SURVEY_AGENT=bench
Environment=RHDB_SURVEY_KEY=put-this-agents-key-here
# The folder the machines write their reports into, as this server sees it.
Environment=RHDB_SURVEY_DIR=/srv/surveys

WorkingDirectory=/opt/rhdb
ExecStart=/usr/bin/python3 /opt/rhdb/survey_agent.py

# It keeps nothing it cannot work out again from the folder, so restarting it is
# always safe, and the right answer to every fault it cannot handle itself: a lost
# network, a register being redeployed, a drive not mounted yet.
#
# Except one: exit 78 is the agent saying it has been set up wrongly, and a key the
# register does not know will not start being one. Restarting on that turns a typo
# into a failed login every few seconds until the register's rate limiter stops
# answering. It stops instead, says why in the journal, and waits for the key to be
# fixed.
Restart=always
RestartPreventExitStatus=78
RestartSec=10

# It moves what the machines leave in the folder and writes beside it, so it runs as
# whoever owns that folder: root, for a FAT image mounted the way boot-lan mounts
# one, whose files all belong to the mount. It is held to that one folder and has no
# business anywhere else on the disk, and the key is in this unit rather than in the
# process's arguments so it does not show up in `ps`.
User=root
ReadWritePaths=/srv/surveys
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M

[Install]
WantedBy=multi-user.target
