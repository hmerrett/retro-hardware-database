{
	# Where Let's Encrypt writes about certificates. From the environment, because
	# it is this installation's address and not a fact about the software.
	email {$RHDB_ACME_EMAIL}
}

# Whatever else this particular installation puts in front of the app: other names
# it answers to, a 301 from a domain it used to live at, a staging host. Those are
# facts about one deployment, so they live in files that are not in git -- see
# caddy/conf.d/README.md. The glob always matches at least the empty file kept
# beside that README, so a deployment that adds nothing still parses.
import /etc/caddy/conf.d/*.caddy

{$RHDB_DOMAIN} {
	# How far back the traffic report can see, in the end: GoAccess is given the
	# rolled-over logs as well as the live one, so it reaches back exactly as far
	# as these keep. A roll is a little under three days at present, so fifteen of
	# them is about six weeks, for some ten megabytes on disk.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 15
		}
		format json
	}

	# Compress on the way out. Caddy leaves already-compressed types alone (the
	# photos, the icons), so what this actually buys is the text: every page of
	# markup, and the QR decoder, which is by far the largest thing we serve.
	# zstd first for a browser that takes it, gzip for everything else.
	encode zstd gzip

	# Security headers Caddy does not add on its own. HSTS tells a browser to
	# reach this name over HTTPS only, for a year. nosniff stops a browser
	# second-guessing a declared content-type (the file downloads already send it;
	# this covers everything). The referrer policy keeps the path off cross-site
	# requests. SAMEORIGIN refuses framing by other sites. A full Content-Security-
	# Policy waits on the inline CSS/JS moving out of base.html into static files.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	reverse_proxy api:8000
}
